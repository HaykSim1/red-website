# Public site URL for canonical + hreflang + sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://redauto.example

# App Store and Google Play listing URLs (badge images and the /app short link point here)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Support email shown on the Contact page (mailto target)
NEXT_PUBLIC_SUPPORT_EMAIL=info@red-auto.store

# Contact form — inbound address (default: info@red-auto.store)
CONTACT_TO=info@red-auto.store

# SMTP for POST /api/contact (required for the form to send mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Social profiles (full URLs). Footer shows an icon only when the variable is set.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# ── Web app section (/[lang]/app) ─────────────────────────────────────────────
# Base URL of the Red Auto API, no trailing slash and no /v1 suffix.
# The browser calls it directly for everything except auth, so this origin must
# also appear in the API's CORS_ORIGINS, and the S3 bucket's CORS policy must
# allow PUT from it (photo upload goes straight to storage via a presigned URL).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional CDN base for media. Falls back to GET /v1/client-config.media_base_url.
NEXT_PUBLIC_MEDIA_BASE_URL=
